digraph EscapeVectors {
  rankdir=LR;
  bgcolor="#0a0e12";
  fontname="Helvetica";
  fontcolor="#dfe6ee";
  label="Container escape vectors: checked vs. skipped by this audit";
  labelloc="t";
  fontsize=20;
  node [style=filled, fontname="Helvetica", fontcolor="#dfe6ee", shape=box, penwidth=1.5];
  edge [color="#556070", fontname="Helvetica"];

  root [fillcolor="#1a1f26", color="#556070", shape=diamond, label="Container escape\nrisk surface"];

  net [fillcolor="#0f2a20", color="#39ffb0", label="✓ Network listeners\n(checked)"];
  caps [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="✗ Capabilities /\nprivileged mode"];
  mounts [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="✗ Bind mounts\n(docker.sock, host paths)"];
  user [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="✗ Running as root?"];
  secc [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="✗ seccomp / AppArmor\nprofile"];
  secrets [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="✗ Secrets in\nenvironment"];
  kernel [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="✗ Kernel/cgroup\nescape surface"];

  root -> net;
  root -> caps;
  root -> mounts;
  root -> user;
  root -> secc;
  root -> secrets;
  root -> kernel;
}
