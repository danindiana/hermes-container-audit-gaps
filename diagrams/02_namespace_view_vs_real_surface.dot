digraph NamespaceView {
  rankdir=TB;
  bgcolor="#0a0e12";
  fontname="Helvetica";
  fontcolor="#dfe6ee";
  label="What /proc shows from inside a namespace vs. the real attack surface";
  labelloc="t";
  fontsize=20;
  node [style=filled, fontname="Helvetica", fontcolor="#dfe6ee", shape=box, penwidth=1.5];
  edge [color="#556070", fontcolor="#ffa93a", fontname="Helvetica"];

  proc [fillcolor="#152a3a", color="#39d0ff", shape=diamond,
        label="Process reads its own\n/proc/net/tcp, tcp6, unix"];

  ownns [fillcolor="#0f2a20", color="#39ffb0",
         label="Shows only sockets in\nTHIS process's own\nnetwork namespace"];

  hostns [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0",
          label="Host namespace, or a\nshared namespace\n(--network host)\nnot visible here at all"];

  udp [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0",
       label="UDP sockets\n(/proc/net/udp, udp6)\nnever checked"];

  future [fillcolor="#3a2a08", color="#ffa93a", fontcolor="#fff3da",
          label="Point-in-time snapshot:\nsays nothing about a\nlistener started a moment later"];

  proc -> ownns;
  ownns -> hostns [style=dashed, color="#ff4d4d", label="blind to"];
  ownns -> udp [style=dashed, color="#ff4d4d", label="blind to"];
  ownns -> future [style=dashed, color="#ffa93a", label="blind to"];
}
